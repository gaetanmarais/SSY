#!/bin/bash
###########################################################################
###########################################################################
#####
##### Script : ssy-cdp
##### Author : Gaetan MARAIS DataCore
#####
##### Desciption : This script will help in the creation of DataCore rollbacks
#####              It's VM centric, it detect any king of VM disks (block or LVM)
#####              generate the associated rollbacks, serves them to the hosts
#####              create a new VM with these new disks
