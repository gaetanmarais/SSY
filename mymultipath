#!/bin/bash
# Author: Gaetan MARAIS
# Date  : 2025/02/15
#
# Script to help multipath diagnose with DataCore SSY vDisks
# - adds FrontEnd info in front of LUN targets
# - can also add SSY vDisk name to Multipath output using SSY RestAPI
#
#############################################################
#  SSY Credentials are stored here : /root/.SSY/credentials
#  Example:
#    ServerHost=xxx.xxx.xxx.xxx
#    SSYUserName=SSYreadonly
#    SSYPassword=SSYpassword
#############################################################

# Ensure self-install
if [ ! -f /usr/local/bin/$(basename "$0") ]; then
  cp "$0" /usr/local/bin
fi

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Cleanup temp files on exit
TMP_LL="/tmp/multipath.ll.$$"
TMP_V3="/tmp/multipath.v3.$$"
trap 'rm -f "$TMP_LL" "$TMP_V3"' EXIT INT TERM

# Check jq
if ! command -v jq &>/dev/null; then
  printf "${RED}JQ package is mandatory. Please install it with ${YELLOW}apt install jq${NC}\n"
  VDISKS=""
else
  # Load credentials
  CREDS_FILE="/root/.SSY/credentials"
  if [ -f "$CREDS_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CREDS_FILE"
    SERVERHOSTS=$(echo "$ServerHost" | tr ',' ' ')
  elif [ -f /etc/pve/storage.cfg ]; then
    PVECONF=$(grep -m1 -A5 datacore: /etc/pve/storage.cfg)
    SERVERHOSTS=$(echo "$PVECONF" | awk '/portals/ {print $2}' | tr ',' ' ')
    SSYUserName=$(echo "$PVECONF" | awk '/DCusername/ {print $2}')
    SSYPassword=$(echo "$PVECONF" | awk '/DCpassword/ {print $2}')
  else
    VDISKS=""
  fi

  # Try fetching VDISKS from one of the hosts
  VDISKS=""
  for DCHOST in $SERVERHOSTS; do
    RESPONSE=$(curl -s -m 3 -k -L -H "ServerHost: ${DCHOST}" \
      -u"${SSYUserName}:${SSYPassword}" \
      "https://${DCHOST}/RestService/rest.svc/1.0/virtualdisks")
    if [[ -n "$RESPONSE" ]] && ! echo "$RESPONSE" | jq -e 'try(.ErrorsCode)' &>/dev/null; then
      VDISKS="$RESPONSE"
      break
    fi
  done

  if [[ -z "$VDISKS" ]]; then
    printf "${RED}Unable to gather data from SSY, please review the credentials${NC}\n"
  fi
fi

echo "DataCore node: $DCHOST"

# Refresh multipath and capture
multipath -r
sleep 2
multipath -ll 1>"$TMP_LL"
multipath -v3 &>"$TMP_V3"

# Devices list
DEVICES=$(awk -F"\||:" '/\| sd/ {print $2}' "$TMP_V3" | sort -u)

# Parse multipath -ll output
while IFS= read -r LINE; do
  VDISK=""
  if [ "$(echo "${LINE}" | grep -c "${DEVICES[*]}")" -eq 0 ]; then
    # Multipath header line
    if echo "$LINE" | grep -q "DataCore,Virtual Disk"; then
      NAA=$(echo "$LINE" | awk -F'[()]' '{print substr($2,2)}' | tr '[:lower:]' '[:upper:]')
      if [[ -n "$VDISKS" ]]; then
        VDISK=$(echo "$VDISKS" | jq --arg name "$NAA" -r '.[] | select(.ScsiDeviceIdString == $name) | .Alias')
      fi
    fi
    if [[ -n "$VDISK" ]]; then
      printf "\n${YELLOW}[${VDISK}]${NC} ${LINE} ${YELLOW}[${VDISK}]${NC}\n"
    else
      case "$LINE" in
        *status=active*)  echo -e "${GREEN}${LINE}${NC}" ;;
        *status=enabled*) echo -e "${BLUE}${LINE}${NC}" ;;
        *)                echo "$LINE" ;;
      esac
    fi
  else
    # Device line
    DEVICE=$(echo "$LINE" | awk -F"[0-9]+\:[0-9]+\:[0-9]+\:[0-9]" '{print $2}' | awk '{print $1}')
    PORTAL=$(awk -F"\| " '{print $2}' "$TMP_V3" | awk "/${DEVICE}: tgt_node_name/ {print \$0}" | awk -F":" '{print $3}' | sort -u)
    if ! echo "$LINE" | grep -q "faulty"; then
      printf "${GREEN}${LINE} ${YELLOW}($PORTAL)${NC}\n"
    else
      printf "${RED}${LINE} ${YELLOW}($PORTAL)${NC}\n"
    fi
  fi
done < "$TMP_LL"
